# 数据库连接。开发环境默认使用项目目录下的 SQLite 文件；修改后需重启 API/Worker。
DIRECTOR_DATABASE_URL=sqlite:///./.data/director.db

# Redis 地址。启用 Redis Streams 队列时使用；修改后需重启 Worker。
REDIS_URL=redis://localhost:6379/0

# S3 兼容对象存储配置；本地 Docker Compose 默认连接 MinIO。
# Compose 容器内使用 http://minio:9000，宿主机不要映射 9000。
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=video-director

# 调度、预算和安全开关。
DIRECTOR_MAX_ATTEMPTS=3
DIRECTOR_PARALLELISM=1
DIRECTOR_PROJECT_BUDGET_USD=75

# WebUI 默认开启登录。首次打开页面时设置管理员账号和密码。
DIRECTOR_AUTH_ENABLED=true

# 以下外围安全策略默认关闭。打开前请确认反向代理和部署环境已经配置好。
DIRECTOR_HOST_CHECK_ENABLED=false
DIRECTOR_CORS_ENABLED=false
DIRECTOR_RATE_LIMIT_ENABLED=false
DIRECTOR_CONTENT_SAFETY_ENABLED=false
DIRECTOR_PROVIDER_SAFETY_ENABLED=false

# 视频 Provider。默认使用无需凭证的 Mock Provider。
VIDEO_PROVIDER=mock
VIDEO_MODEL=video-model
VIDEO_COST_PER_SECOND_USD=0.25
MOCK_VIDEO_COST_USD=1.25

# Fal/Replicate 风格的异步视频接口。以下凭证属于敏感信息，不要提交 Git。
FAL_BASE_URL=
FAL_API_KEY=
REPLICATE_API_TOKEN=

# 本地 ComfyUI 服务地址。
COMFYUI_BASE_URL=http://localhost:8188

# 可选的 OpenAI 兼容 LLM/VLM 配置。API Key 属于敏感信息，不要提交 Git。
# 默认 CLI/API 启动配置仍使用确定性的 Mock Judge，无需填写凭证即可运行。
OPENAI_BASE_URL=
OPENAI_API_KEY=
DIRECTOR_LLM_MODEL=gpt-4o-mini
DIRECTOR_VLM_MODEL=
DIRECTOR_LLM_TEMPERATURE=0
DIRECTOR_LLM_MAX_TOKENS=

# WebUI 构建参数（Docker 部署时通常无需修改）。
DIRECTOR_WEB_HOST=0.0.0.0
DIRECTOR_WEB_PORT=3000

# Docker Compose 默认使用 GitHub Container Registry 中的发布镜像。
# 需要从当前工作区构建时，执行：docker compose up -d --build。
OPENCINE_API_IMAGE=ghcr.io/wrhc2010/opencine-ai-api
OPENCINE_WEB_IMAGE=ghcr.io/wrhc2010/opencine-ai-web
OPENCINE_IMAGE_TAG=v0.1.1
